generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  ACTIVE
  LOCKED
  CLOSED
  ARCHIVED
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WalletStatus {
  ACTIVE
  LOCKED
  CLOSED
}

enum MemberRole {
  ADMIN
  FINANCE_MANAGER
  ORGANIZER
  VIEWER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String        @db.VarChar(100)
  email               String        @unique @db.VarChar(255)
  passwordHash        String        @map("password_hash")
  status              UserStatus    @default(ACTIVE)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  createdTransactions Transaction[] @relation("TransactionCreator")

  organizations           Organization[]
  organizationMemberships OrganizationMember[]
  memberships             EventMember[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  creator User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  members OrganizationMember[]
  events  Event[]

  @@index([createdBy])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  status         MemberStatus     @default(INVITED)
  joinedAt       DateTime?        @map("joined_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_members")
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String      @db.VarChar(150)
  description    String?     @db.Text
  startDate      DateTime?   @map("start_date")
  endDate        DateTime?   @map("end_date")
  status         EventStatus @default(DRAFT)
  currency       String      @default("INR") @db.VarChar(3)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members      EventMember[]
  wallet       Wallet?

  @@index([organizationId])
  @@index([status])
  @@map("events")
}

model EventMember {
  id                 String       @id @default(uuid()) @db.Uuid
  eventId            String       @map("event_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  role               MemberRole   @default(ORGANIZER)
  status             MemberStatus @default(INVITED)
  transactionEnabled Boolean      @default(true) @map("transaction_enabled")
  joinedAt           DateTime?    @map("joined_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status])
  @@map("event_members")
}

model Wallet {
  id           String        @id @default(uuid()) @db.Uuid
  eventId      String        @unique @map("event_id") @db.Uuid
  name         String        @default("Main Wallet") @db.VarChar(100)
  currency     String        @default("INR") @db.VarChar(3)
  status       WalletStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

model Transaction {
  id        String @id @default(uuid()) @db.Uuid
  walletId  String @map("wallet_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid

  type        TransactionType
  amountPaise BigInt          @map("amount_paise")
  category    String          @db.VarChar(100)
  description String?         @db.Text

  // A reversal points to the original transaction.
  reversesId String? @unique @map("reverses_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  wallet  Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  creator User   @relation("TransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  reverses       Transaction? @relation("TransactionReversals", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     Transaction? @relation("TransactionReversals")
  reversalReason String?      @map("reversal_reason") @db.VarChar(500)

  @@index([walletId, createdAt])
  @@index([createdBy, createdAt])
  @@index([type, createdAt])
  @@map("transactions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String?  @map("event_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String   @map("entity_id") @db.VarChar(100)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
